    },
    {
      "name": "th_sensor",
      "details": "optional BLE thermometer binding/read: 0x08 MAC, 0x10 temp/offset/unit, 0x32 auto program",
      "source": "jadx-splits/split_pact_fanlight/sources/com/govee/fanlight/sensor/"
    },
    {
      "name": "matter",
      "details": "not enabled; only com.govee.matter.pact.BleComm UUID plumbing",
      "source": "jadx-splits/split_pact_fanlight/sources/com/govee/fanlight/ble/Ble.java"
    }
  ],
  "dynamic_effects": [
    {
      "name": "fan_wind_mode",
      "submode": "0x31/0x03",
      "payload": "31 03 01 00 <mode> [auto6]",
      "attributes": [
        "mode 0 direct",
        "1 sleep",
        "2 natural",
        "3 auto",
        "auto program on/keep gear + degF*100"
      ],
      "source": "ble/ControllerFan.java + h1370/FanAutoProgram.java"
    },
    {
      "name": "fan_gear",
      "submode": "0x31/0x01",
      "payload": "31 01 <gear>",
      "attributes": [
