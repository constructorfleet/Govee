        "1..12 H1370"
      ],
      "source": "ble/ControllerFan.java + Support.d"
    },
    {
      "name": "fan_reverse",
      "submode": "0x31/0x02",
      "payload": "31 02 <0/1>",
      "attributes": [
        "direction"
      ],
      "source": "ble/ControllerFan.java"
    },
    {
      "name": "fan_shake",
      "submode": "0x31/0x04",
      "payload": "31 04 <0/1>",
      "attributes": [
        "oscillation",
        "H1370 only"
      ],
      "source": "ble/ControllerFan.java"
    },
    {
      "name": "scene",
      "submode": "0x05/0x04",
      "payload": "05 04 <effLo> <effHi>",
      "attributes": [
        "16-bit LE effect id",
        "groups 0,1,2,3,5 H1310 / 0,1,2,3,6,5 H1370"
      ],
      "source": "ScenesOp + Support.l"
    },
    {
      "name": "diy",
      "submode": "0x05/0x0A",
      "payload": "05 0A <diyLo> <diyHi>",
      "attributes": [
        "16-bit LE DIY code",
        "H1310 main effects 1-4 / sub effects 1-9",
        "H1370 effect types 1-7,8,9,10,11"
      ],
      "source": "h1310/diy/Pro4H1310Diy.java, h1370/diy/H1370DiyNewConfig.java"
    },
    {
      "name": "music",
      "submode": "0x05/0x13",
      "payload": "05 13 <musicCode> <sensitivity>",
      "attributes": [
        "sensitivity 0..99",
        "mic/online music"
      ],
      "source": "base2light music sub-mode"
    },
    {
      "name": "color_ring",
      "submode": "0x05/0x15",
      "payload": "15 <subtype ...>",
      "attributes": [
        "9 segments H1310",
        "14 segments H1370",
        "segment bitmask 32-bit",
        "CT big-endian",
        "per-segment color groups"
      ],
      "source": "capability/FanlightLightCapabilitySpecKt.java"
    },
    {
      "name": "auto_program",
      "submode": "0x32 read / 0x31 write",
      "payload": "AA 32 01 / 31 03 01 00 03 <onGear,onTempHi,onTempLo,keepGear,keepTempHi,keepTempLo>",
      "attributes": [
        "temperature degF*100",
        "gear clamp to SKU max"
      ],
      "source": "h1370/FanAutoProgram.java"
    }
  ],
  "notes": "Fanlight has no family SubMode* classes; 0x15 color layout is inferred from the declared COLOR_MODE_0X15 instruction version and matches the floorlamp H60B1 implementation. Scene/music catalogues are cloud-driven. No LAN/MQTT code; cloud devices use ptReal."
}
