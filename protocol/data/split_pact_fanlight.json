      },
      {
        "cmd": "status",
        "data": {},
        "response": "state+op",
        "source": "base2light AbsIotManagerV1"
      },
      {
        "cmd": "online",
        "data": {},
        "response": "status",
        "source": "base2light AbsIotManagerV1"
      }
    ],
    "status": {
      "fields": {
        "state.onOff": "int 0/1",
        "state.brightness": "int 1..100",
        "state.colorTemInKelvin": "int kelvin",
        "state.mode": "int",
        "op.command": "array of base64 20-byte BLE frames (0x31 fan, 0x05 mode, 0x41 color strip, 0x11/0x12/0x23 timers)"
      },
      "source": "jadx-splits/split_pact_fanlight/sources/com/govee/fanlight/adjust/VM4Light.java F1/A1 + base2light Info4Detail"
    }
  },
  "other_protocols": [
