  "ble": {
    "service_uuid": "00010203-0405-0607-0809-0a0b0c0d1910",
    "characteristic_uuid": "00010203-0405-0607-0809-0a0b0c0d2b11",
    "frame": "20 bytes: [0]=proType [1]=cmdType [2..18]=payload [19]=XOR BCC of bytes 0..18",
    "commands": [
      {
        "name": "power",
        "op": "0x33/0x01",
        "payload": "01 <0/1>",
        "layout": "[0] 0=off 1=on",
        "response": "0xAA/0x01 -> [0] state",
        "source": "base2light/ble/controller/SwitchController.java"
      },
      {
        "name": "brightness",
        "op": "0x33/0x04",
        "payload": "04 <1..100>",
        "layout": "[0] brightness 1-100",
        "response": "0xAA/0x04 -> [0] brightness",
        "source": "base2light/ble/controller/BrightnessController.java"
      },
      {
        "name": "heartbeat",
        "op": "0xAA/0x01",
        "payload": "01",
        "layout": "no payload",
        "response": "[0] non-zero = alive",
        "source": "base2light/ble/controller/HeartController.java"
      },
      {
        "name": "fan_switch",
        "op": "0x33/0x31",
        "payload": "31 00 <0/1>",
        "layout": "[0]=0x00 subtype, [1] on/off",
        "response": "0xAA/0x31 fan info notify",
        "source": "jadx-splits/split_pact_fanlight/sources/com/govee/fanlight/ble/ControllerFan.java"
      },
      {
        "name": "fan_gear",
        "op": "0x33/0x31",
        "payload": "31 01 <gear>",
        "layout": "[0]=0x01 subtype, [1] gear 1..6 (H1310) / 1..12 (H1370)",
        "response": "0xAA/0x31 subtype 1 -> [1] gear",
        "source": "jadx-splits/split_pact_fanlight/sources/com/govee/fanlight/ble/ControllerFan.java"
      },
      {
        "name": "fan_reverse",
        "op": "0x33/0x31",
        "payload": "31 02 <0/1>",
        "layout": "[0]=0x02 subtype, [1] reverse wind",
        "response": "0xAA/0x31 subtype 2",
        "source": "jadx-splits/split_pact_fanlight/sources/com/govee/fanlight/ble/ControllerFan.java"
      },
      {
        "name": "fan_mode",
        "op": "0x33/0x31",
        "payload": "31 03 01 00 <mode> [auto6]",
        "layout": "[0]=0x03, [1]=0x01, [2]=0x00, [3] mode 0=direct 1=sleep 2=natural 3=auto; when 3, 6 auto-program bytes appended",
        "response": "0xAA/0x31 subtype 3 -> [1..2] int16 LE shake/aux",
        "source": "jadx-splits/split_pact_fanlight/sources/com/govee/fanlight/ble/ControllerFan.java"
      },
      {
        "name": "fan_shake",
        "op": "0x33/0x31",
        "payload": "31 04 <0/1>",
        "layout": "[0]=0x04 subtype, [1] shake/oscillate head (H1370)",
        "response": "0xAA/0x31 subtype 4",
        "source": "jadx-splits/split_pact_fanlight/sources/com/govee/fanlight/ble/ControllerFan.java"
      },
      {
        "name": "sub_light_switch",
        "op": "0x33/0x36",
        "payload": "36 <idx> <0/1>",
        "layout": "[0] 0=main light, 1=back light; [1] on/off",
        "response": "0xAA/0x36",
        "source": "jadx-splits/split_pact_fanlight/sources/com/govee/fanlight/ble/ControllerSubSwitch.java"
      },
      {
        "name": "remote_pair",
        "op": "0x33/0xA4",
        "payload": "A4 01",
        "layout": "[0]=1 start pairing",
        "response": "0xAA/0xA4 -> [0] result",
        "source": "jadx-splits/split_pact_fanlight/sources/com/govee/fanlight/ble/RemoteController.java"
      },
      {
        "name": "remote_exit_pair",
        "op": "0x33/0xA6",
        "payload": "A6",
        "layout": "no payload",
        "response": "0xAA/0xA6",
        "source": "jadx-splits/split_pact_fanlight/sources/com/govee/fanlight/ble/ExitRemoteController.java"
      },
      {
        "name": "color_or_colortem",
        "op": "0x33/0x05",
        "payload": "05 15 <subtype...>",
        "layout": "shared 0x15 color instruction: subtype 1=RGB+CT+mask (01 R G B CT_H CT_L R2 G2 B2 M0 M1 M2 M3), subtype 2=brightness (02 val M0 00 00), subtype 3=brightness set, subtype 4=strip group (04 group R G B ...)",
        "response": "0xAA/0x05 payload 01",
        "source": "capability/FanlightLightCapabilitySpecKt.java (ColorInstructionVersion.COLOR_MODE_0X15); format per base2light SubModeColor 0x15"
      },
      {
        "name": "scene",
        "op": "0x33/0x05",
        "payload": "05 04 <effLo> <effHi>",
        "layout": "16-bit little-endian effect code, no speed byte",
        "response": "0xAA/0x05 subtype 4",
        "source": "base2light/ble/controller/AbsModeController.java + ScenesOp"
      },
      {
        "name": "diy",
        "op": "0x33/0x05",
        "payload": "05 0A <diyLo> <diyHi>",
        "layout": "16-bit little-endian DIY code",
        "response": "0xAA/0x05 subtype 10",
        "source": "base2light/pact/newdetail/sub/SubMode4Diy.java"
      },
      {
        "name": "music",
        "op": "0x33/0x05",
        "payload": "05 13 <musicCode> <sensitivity>",
        "layout": "musicCode (cloud/online music id), sensitivity 0..99",
        "response": "0xAA/0x05 subtype 19",
        "source": "base2light music sub-mode"
      },
      {
        "name": "read_mode",
        "op": "0xAA/0x05",
        "payload": "05 01",
        "layout": "AbsModeController.p() = {0x01}",
        "response": "0xAA/0x05 -> [0] mode, [1..] sub-mode",
        "source": "base2light/ble/controller/AbsModeController.java"
      },
      {
        "name": "read_color_group",
        "op": "0xAA/0xA5",
        "payload": "A5 <group>",
        "layout": "response [0]=group, then 4 x (brightness,R,G,B)",
        "response": "0xAA/0xA5",
        "source": "base2light/kt/general_controller/Controller4ColorInfoByGroup.java"
      },
      {
        "name": "read_auto_program",
        "op": "0xAA/0x32",
        "payload": "32 01",
        "layout": "response: [1] onGear, [2..3] onTemp int16 LE degF*100, [4] keepGear, [5..6] keepTemp int16 LE degF*100",
        "response": "0xAA/0x32",
        "source": "jadx-splits/split_pact_fanlight/sources/com/govee/fanlight/sensor/SensorBleReads.java + h1370/FanAutoProgram.java"
      },
      {
        "name": "read_bound_sensor_mac",
        "op": "0xAA/0x08",
        "payload": "08",
        "layout": "response 6-byte MAC, reversed order",
        "response": "0xAA/0x08",
        "source": "jadx-splits/split_pact_fanlight/sources/com/govee/fanlight/sensor/SensorBleReads.java"
      },
      {
        "name": "read_sensor_data",
        "op": "0xAA/0x10",
        "payload": "10",
        "layout": "response: [0] bit0 online bit7 built-in; [1..3] packed temp 24-bit LE unit 0.001 degC bit23=sign; [4] offset minutes; [5] unit 1=degF else degC; 0xFFFFFF=invalid",
        "response": "0xAA/0x10",
        "source": "jadx-splits/split_pact_fanlight/sources/com/govee/fanlight/sensor/SensorBleParser.java"
      }
    ],
    "notifications": [
      {
        "name": "light_switches",
        "op": "0xEE/0x30",
        "layout": "[1] overall switch, [2] main light, [3] back light",
        "source": "base2light/kt/general_parser/DefParser.java makeFanlightSwitchNotifyParser"
      },
      {
        "name": "fan_info",
        "op": "0xEE/0x31",
        "layout": "[0] sub-type 0=fan on [1]==1, 1=gear [1], 2=reverse [1]==1, 3=shake int16 LE [1..2], 4=auto/standby [1]==1",
        "source": "base2light/kt/general_parser/DefParser.java makeFanlightInfoNotifyParser"
      },
      {
        "name": "brightness",
        "op": "0xEE/0x20",
        "layout": "[0] brightness 0-100",
        "source": "base2light/kt/general_parser/DefParser.java makeBrightnessNotifyParser"
      },
      {
        "name": "device_status",
        "op": "0xEE/0x40",
        "layout": "first 10 payload bytes forwarded to EventDeviceStatus",
        "source": "base2light/ble/DeviceStatusNotifyParse.java"
      },
      {
        "name": "remote_control",
        "op": "0xEE/0xA4",
        "layout": "[0] remote pairing/status byte",
        "source": "base2light/kt/general_parser/DefParser.java makeRemoteControlNotifyParser"
      },
      {
        "name": "wifi",
        "op": "0xEE/0x11",
        "layout": "[0]==0 -> WiFi connected",
        "source": "jadx-splits/split_pact_fanlight/sources/com/govee/fanlight/ble/BleNotifyComm.java"
      },
      {
        "name": "music",
        "op": "0xEE/0x70+",
        "layout": "OnlineSound MusicNotifyParse frames",
        "source": "jadx-splits/split_pact_fanlight/sources/com/govee/fanlight/ble/BleNotifyComm.java"
      }
    ]
  },
  "iot": {
    "envelope": "Write/AbsCmdWrite; builders report IotMsgProType.V2 (IotMsgV2); settings/status parse state+op of V1-style JSON",
    "commands": [
      {
        "cmd": "turn",
        "data": {
          "val": "0/1"
        },
        "example": "{\"msg\":{\"transaction\":\"<t>\",\"type\":1,\"origin\":32,\"cmd\":\"turn\",\"data\":{\"val\":1}}}",
        "response": "status",
        "source": "jadx-splits/split_pact_fanlight/sources/com/govee/fanlight/pact/IotSwitchCmdBuilder.java"
      },
      {
        "cmd": "brightness",
        "data": {
          "val": "1..100"
        },
        "response": "status",
