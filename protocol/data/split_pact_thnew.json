  "other_protocols": [
    {"name": "ble-broadcast", "details": "62-byte advert; parseThBleValidBytePos finds len>=6, 0xFF, 0x01; 7-byte block: flags, packed temp/hum (parseThValue), battery. 3-byte packed: signed BE int, temp=(v/1000)*10, hum=(v%1000)*10. H5112/H5140/H5220 have 9-11 byte extended blocks (dual probe / CO2 / packed 10-bit fields).", "source": "ThBroadcastUtil; BleUtil.parseThBleValidBytePos; base widget/view/temHumDevice/ble/*"},
    {"name": "gateway-subdevice", "details": "H5107/H5109/H5310 are GW_NO_BLE_TH; sub-sensors are read through the gateway and use the same TH packing.", "source": "pact/h5112; pact/h5220; GwSubDeviceItemImp"},
    {"name": "wifi", "details": "H5103/H5179 WIFI_TH: WiFi provisioning + cloud status; BLE only for setup/pairing.", "source": "config/ThDeviceProfiles"},
    {"name": "chart-gatt", "details": "chart data characteristic 494e...2012 (or 2014 when ThDeviceProfiles.d()==2) and chart manager characteristic 494e...2013 (or 2015); 16-byte records with 2-byte relative minute stamp.", "source": "ble/ThChartDataManager; ThChartDataComm"},
    {"name": "ota", "details": "ota4om, ota4tl, ota4v1, ota4frk, ota4common, ota4v2.", "source": "update/*"},
    {"name": "gidsafe", "details": "Reads/writes device GID and WiFi MAC over BLE.", "source": "gidsafe/*"}
