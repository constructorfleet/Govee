  "dynamic_effects": [
    {"name": "temperature warning", "submode": "0x04", "payload": "enable minLE16 maxLE16 delayMin", "attributes": ["enable", "min/max -20..60C x100", "delay minutes"], "source": "Controller4TemWarning"},
    {"name": "humidity warning", "submode": "0x03", "payload": "enable minLE16 maxLE16", "attributes": ["0-100% x100"], "source": "Controller4HumWarning"},
    {"name": "PM2.5 warning", "submode": "0x1B", "payload": "enable minLE16 maxLE16", "attributes": ["0-999 ug/m3"], "source": "Controller4Pm25Warning"},
    {"name": "CO2 warning/grades", "submode": "0x1C/0x1E", "payload": "enable minLE16 maxLE16 | minLE16 maxLE16", "attributes": ["0-5000 ppm", "grade default 1100/1800"], "source": "Controller4Co2Warning; Controller4Co2SetGrade"},
    {"name": "comfort temperature/humidity", "submode": "0x34", "payload": "minTemLE16 maxTemLE16 minHumLE16 maxHumLE16", "attributes": ["x100"], "source": "h5171/Controller4ComfortTemHum"}
  ],
  "notes": "Consolidated TH module: 23 goodsType profiles + legacy SKUs. BLE uses service 494e...4857 and characteristic ...2011/2012/2014; hearts carry temp/hum in 0.01 units, 0xFFFF invalid. Broadcast is the primary passive path with 3-byte packed values. H5107/H5109/H5310 are gateway-only; H5103/H5179 are WiFi; H5106 adds PM2.5 and H5140 adds CO2. Legacy SKUs have goodsType 0 and resolve from the server. parseThValue's unit and H5106's 4-vs-5-byte PM2.5 block are ambiguous (see md gaps)."
}
