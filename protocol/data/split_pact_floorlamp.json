        "cmd": "online",
        "data": {},
        "response": "status",
        "source": "base2light AbsIotManagerV1"
      }
    ],
    "status": {
      "fields": {
        "state.onOff": "int 0/1",
        "state.brightness": "int 1..100",
        "state.mode": "int",
        "state.colorTemInKelvin": "int (H6071/H6075)",
        "op.command": "array of base64 20-byte frames",
        "op frame 0x05": "mode + sub-mode (0x04 scene / 0x0A DIY / 0x0D color / 0x13 music / 0x15 color / 0x2C operate)",
        "op frame 0x41/0x42": "switch bits / splicing value (H60B0 group)",
        "op frame 0x23/0x11/0x12": "timers / sleep / wakeup"
      },
      "source": "h6071/iot/CmdStatusV0.java; h60b0/adjust/h60b0/Info4Detail.java; base2light AbsIotManagerV1"
    }
