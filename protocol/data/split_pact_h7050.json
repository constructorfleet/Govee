  "ble": {
    "service_uuid": "00010203-0405-0607-0809-0a0b0c0d1910",
    "characteristic_uuid": "00010203-0405-0607-0809-0a0b0c0d2b11",
    "frame": "20 bytes: [0]=proType [1]=cmdType [2..18]=payload [19]=XOR BCC; single 0x33 write/0xAA read; multi 0xA3",
    "commands": [
      {
        "name": "power",
        "op": "0x33/0x01",
        "payload": "01|00",
        "layout": "[0] state",
        "response": "0xAA/0x01 -> [0]",
        "source": "base2light/ble/controller/SwitchController.java"
      },
      {
        "name": "brightness",
        "op": "0x33/0x04",
        "payload": "0..100",
        "layout": "[0]",
        "response": "0xAA/0x04 -> [0]",
        "source": "base2light/ble/controller/BrightnessController.java"
      },
      {
        "name": "mode",
        "op": "0x33/0x05",
        "payload": "sub-mode",
        "layout": "sub[0] = 0x15 color, 0x04 scenes, 0x0A DIY, 0x13 music, 0x05 mic",
        "response": "0xAA/0x05",
        "source": "h7050/ble/Mode.java, h7050/ble/ModeController.java"
      },
      {
        "name": "segmentSetting",
        "op": "0x33/0x40",
        "payload": "totalLo totalHi total",
        "layout": "total = bulbNum*perBulb LE16 at [0..1], [2]=low byte",
        "response": "0xEE/0x40",
        "source": "h7050/ble/SegmentSettingController.java"
      },
      {
        "name": "powerOrder",
        "op": "0x33/0x30",
        "payload": "order",
        "layout": "[0] order mode",
        "response": "0xAA/0x30",
        "source": "h7050/ble/PowerOrderController.java"
      },
      {
        "name": "cutCalibration",
        "op": "0x33/0x44",
        "payload": "01 index",
        "layout": "[0]=1 [1]=cut index",
        "response": "0xAA/0x44",
        "source": "h7050/ble/CutCaliController.java"
      },
      {
        "name": "bulbStringColorRead",
        "op": "0xAA/0xA5",
        "payload": "index",
        "layout": "read BulbGroupColor.parseBytes",
        "response": "0xEE/0xA5",
        "source": "h7050/ble/BulbStringColorController.java"
      },
      {
        "name": "multiMusic",
        "op": "0x33/0x41",
        "payload": "len code sens ...",
        "layout": "packed layer block then 0x13 trailer",
        "response": "0xEE/0x41",
        "source": "h7050/ble/MultiMusicController.java"
      },
      {
        "name": "micPoint",
        "op": "0x33/0x05",
        "payload": "05 00 r g b",
        "layout": "[0]=5 [1]=0 [2..4]=rhythm point RGB",
        "response": "0xAA/0x05",
        "source": "h7050/ble/MicController.java"
      },
      {
        "name": "secretKeyWrite",
        "op": "0x33/0xB2",
        "payload": "key bytes",
        "layout": "16-byte secret; base SecretKeyController defaults 0xB2 write / 0xB1 read",
        "response": "0xAA/0xB1 read",
        "source": "h7050/scenes/BleSecretBuilderV1.java, base2light/ble/controller/SecretKeyController.java"
      },
      {
        "name": "installCalibrationH3501",
        "op": "0x33/0x39",
        "payload": "index",
        "layout": "H3501 only (value_install_calibration_h3501=57)",
        "response": "0xEE/0x39",
        "source": "h7050/pact/BleProtocol.java, newdetail/h3501/H3501CalibrationAc.java"
      }
    ],
    "notifications": [
      {
        "name": "wifi",
        "op": "0x11",
        "layout": "[0]==0 connected",
        "source": "h7050/ble/WifiNotifyParse.java"
      },
      {
        "name": "brightness",
        "op": "0x20",
        "layout": "[0] 0..100",
        "source": "h7050/ble/BrightnessNotifyParse.java"
      },
      {
        "name": "deviceStatus",
        "op": "0x40",
        "layout": "first 10 bytes",
        "source": "base2light/ble/DeviceStatusNotifyParse.java"
      }
    ]
  },
  "iot": {
    "envelope": "Write/AbsCmdWrite; simple cmds V0, switch reply parsed as IotMsgV2",
    "commands": [
      {
        "cmd": "turn",
        "data": {
          "val": "0|1"
        },
        "example": "{\"msg\":{\"type\":1,\"cmd\":\"turn\",\"data\":{\"val\":1}}}",
        "response": "status",
        "source": "h7050/iot/CmdTurn.java"
      },
      {
        "cmd": "brightness",
        "data": {
          "val": "0..100"
        },
        "example": "{\"msg\":{\"type\":1,\"cmd\":\"brightness\",\"data\":{\"val\":50}}}",
        "response": "status",
        "source": "h7050/iot/CmdBrightness.java"
      },
      {
        "cmd": "colorwc",
        "data": {
          "color": {
            "r": "0..255",
            "g": "0..255",
            "b": "0..255"
          },
          "colorTemInKelvin": "int"
        },
        "example": "{\"msg\":{\"type\":1,\"cmd\":\"colorwc\",\"data\":{\"color\":{\"r\":255,\"g\":0,\"b\":0},\"colorTemInKelvin\":0}}}",
        "response": "status",
        "source": "h7050/iot/CmdColorWc.java, base2light/iot/Color.java"
      },
      {
        "cmd": "ptReal",
        "data": {
          "command": [
            "<base64 20-byte frame>"
          ],
          "isSetDynamic": "bool"
        },
        "example": "{\"msg\":{\"type\":1,\"cmd\":\"ptReal\",\"data\":{\"command\":[\"...\"]}}}",
        "response": "op.pt[]",
        "source": "h7050/iot/CmdPtReal.java"
      },
      {
        "cmd": "status",
        "data": {},
        "example": "{\"msg\":{\"type\":0,\"cmd\":\"status\"}}",
        "response": "state + op",
        "source": "h7050/iot/Cmd.java"
      },
      {
        "cmd": "online",
        "data": {},
        "example": "{}",
        "response": "online",
        "source": "h7050/iot/Cmd.java"
      },
      {
        "cmd": "pt",
        "data": {},
        "example": "{}",
        "response": "legacy passthrough",
        "source": "h7050/iot/Cmd.java"
      }
    ],
    "status": {
      "fields": {
