        "response": "op.command",
        "source": "hollowlamp/iot/CmdPtReal.java; h6057/origin/iot/CmdPtReal.java; straightfloorlamp/iot/CmdPtReal.java; tablelampv1/iot/CmdPtReal.java"
      },
      {
        "cmd": "status",
        "data": {},
        "response": "state+op",
