      },
      {
        "cmd": "online",
        "data": {},
        "response": "status",
        "source": "base2light AbsIotManagerV1"
      }
    ],
    "status": {
      "fields": {
        "state.onOff": "int 0/1",
        "state.brightness": "int 1..100",
        "state.mode": "int",
        "op.command": "array of base64 20-byte frames",
        "op frame 0x05": "mode + sub-mode",
        "op frame 0x23/0x11/0x12": "timers / sleep / wakeup",
        "op frame 0xA5/0xA6/0xA7": "local color table size / auto induction / sensitivity (hollowlamp)",
        "op frame 0x16/0x01": "energy saving (hollowlamp V1)",
        "op frame 0x34": "detail info (H6057)"
