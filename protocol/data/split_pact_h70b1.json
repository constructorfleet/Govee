      {"name": "color (all families)", "op": "0x33/0x05, submode 0x0D or 0x15", "payload": "0D R G B kelLo kelHi R2 G2 B2 (H70B1/B2/BC/B3/B4/B5/H681x/H6800); 15 01 R G B kelLo kelHi R2 G2 B2 mask0..n (H70DX 10-seg)", "layout": "Kelvin 1000..10000K; H70DX mask 10 bits", "response": "read-back", "source": "h70b1/origin/ble/SubModeColor.java; h70b3/ble/SubModeColor.java; h70dx/ble/SubModeColor.java"},
      {"name": "music", "op": "0x33/0x05, submode 0x13", "payload": "13 musicCode sens", "layout": "code default 101 (H70B1/H70B3/H70DX); sensitivity 0..99", "response": "read-back", "source": "h70b1/origin/ble/SubModeMusic.java; h70b3/ble/SubModeMusic.java; h70dx/ble/SubModeMusic.java"},
      {"name": "scene", "op": "0x33/0x05, submode 0x04", "payload": "04 effLo effHi musicByte (H70B1/B3/H70DX); 04 effLo effHi musicLo musicHi (H7086 sibling)", "layout": "16-bit LE effect; music byte is a music/scene flavour id", "response": "read-back", "source": "family SubModeScenes.java"},
      {"name": "DIY", "op": "0x33/0x05, submode 0x0A", "payload": "0A diyLo diyHi", "layout": "16-bit LE DIY code", "response": "read-back", "source": "family SubModeNewDiy.java"},
