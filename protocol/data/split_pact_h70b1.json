      {"name": "brightness", "op": "0x33/0x04", "payload": "<level>", "layout": "[0] level", "response": "0xAA/0x04 -> [0]", "source": "h70b1/origin/pact/Comm.java; h70b3/pact/Comm.java; h70dx/pact/Comm.java"},
