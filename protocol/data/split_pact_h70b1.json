      {"name": "device / install number", "op": "0x33/0x40 (read no payload)", "payload": "[count]", "layout": "read returns count; write sets count", "response": "read", "source": "h70b3/adjust/controller/ControllerDeviceNum.java"},
      {"name": "change splicing", "op": "0x33/0x40", "payload": "01 index dirMask MAC[6]...", "layout": "dirMask bits: 01100000/01101100 (dir 0), 10010000/10011100 (dir 1), 11011000 (dir!=0/1)", "response": "write ack", "source": "h70bx/controller/ControllerChangeSplicing.java"},
