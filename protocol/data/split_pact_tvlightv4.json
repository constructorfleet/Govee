 "ble": {
  "service_uuid": "00010203-0405-0607-0809-0a0b0c0d1910",
  "characteristic_uuid": "00010203-0405-0607-0809-0a0b0c0d2b11",
  "frame": "20 bytes: [0]=proType [1]=cmdType [2..18]=payload [19]=XOR BCC; write proType 0x33, read 0xAA",
  "commands": [
   {
    "name": "power",
    "op": "0x33/0x01",
    "payload": "00|01",
    "layout": "[0] 0=off 1=on",
    "response": "0xAA/0x01 -> [0] state",
    "source": "base2light/ble/controller/SwitchController via pact_tvlightv*/pact/Comm.java"
   },
   {
    "name": "brightness",
    "op": "0x33/0x04",
    "payload": "<level>",
    "layout": "[0] level; v4 range 20..254 raw; v2 may remap via NumUtil.calculateProgress when pact V1",
    "response": "0xAA/0x04 -> [0]",
    "source": "pact_tvlightv4/pact/Comm.java#makeBrightness4BleComm; pact_tvlightv2/pact/Support.java#getBrightnessRange"
   },
   {
    "name": "heart/status",
    "op": "0x33/0x01 (write); 0xAA/0x01 (read)",
    "payload": "00|01",
    "layout": "write on/off; read valid bytes [0] state (0x11 both,0x01 main,0x10 background,0x00 none), [1] feast flag (v3/v4)",
    "response": "0xAA/0x01",
    "source": "pact_tvlightv4/ble/TvHeartController.java; pact_tvlightv3/ble/TvHeartController.java"
   },
   {
    "name": "mode container",
    "op": "0x33/0x05",
    "payload": "<submode payload>",
    "layout": "[0]=sub-mode id, [1..] payload; see dynamic_effects",
    "response": "0xAA/0x05 with p()={1} -> [0]=submode, [1..] payload",
    "source": "base2light/ble/controller/AbsModeController + pact_tvlightv*/ble/ModeController.java"
   },
   {
    "name": "all-light switch",
    "op": "0x33/0x33",
    "payload": "00|01|10|11",
    "layout": "[0] 0=both off,1=main on,0x10=background on,0x11=both on",
    "response": "read same",
    "source": "pact_tvlightv4/ble/SingleLightController.java"
   },
   {
    "name": "swap light position",
    "op": "0x33/0x34",
    "payload": "",
    "layout": "no payload",
    "response": "write ack",
    "source": "pact_tvlightv4/ble/SwapLightController.java"
   },
   {
    "name": "light direction",
    "op": "0x33/0x30",
    "payload": "<dir>",
    "layout": "[0] 0/1 direction",
    "response": "0xAA/0x30 -> [0]",
    "source": "pact_tvlightv4/ble/LightDirectionController.java"
   },
   {
    "name": "camera position",
    "op": "0x33/0x31",
    "payload": "<pos>",
    "layout": "[0] cameraPos",
    "response": "0xAA/0x31 -> [0]",
    "source": "pact_tvlightv4/ble/CameraPosController.java"
   },
   {
    "name": "check camera",
    "op": "0x33/0x32",
    "payload": "",
    "layout": "no payload",
    "response": "[0] 0/1",
    "source": "pact_tvlightv4/ble/CheckCameraController.java"
   },
   {
    "name": "start time (v4)",
    "op": "0xAA/0x35",
    "payload": "",
    "layout": "read",
    "response": "[0] 0..255",
    "source": "pact_tvlightv4/ble/StartTimeController.java"
   },
   {
    "name": "start time (v2)",
    "op": "0xAA/0x34",
    "payload": "",
    "layout": "read (StartTimeControllerV1 uses 0x35)",
