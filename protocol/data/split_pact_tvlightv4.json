 "iot": {
  "envelope": "CmdBuilder.makeCmdStr -> Write.getWriteMsg4Transaction (type=1, origin=32); responses parsed as IotMsgProType.V2 (IotMsgV2)",
  "commands": [
   {
    "cmd": "turn",
    "data": {
     "val": "0|1",
     "subVal": "[v1,v2] (v4)"
    },
    "example": "{\"msg\":{\"cmd\":\"turn\",\"data\":{\"val\":1,\"subVal\":[1,1]}}}",
    "response": "status/state",
    "source": "pact_tvlightv4/iot/CmdTurn.java"
   },
   {
    "cmd": "brightness",
    "data": {
     "val": "int"
    },
    "example": "{\"msg\":{\"cmd\":\"brightness\",\"data\":{\"val\":100}}}",
    "response": "state.brightness",
    "source": "pact_tvlightv4/iot/CmdBrightness.java"
   },
   {
    "cmd": "colorwc",
    "data": {
     "color": {
      "red": "0-255",
      "green": "0-255",
      "blue": "0-255"
     },
     "colorTemInKelvin": "int (0 for RGB)"
    },
    "example": "{\"msg\":{\"cmd\":\"colorwc\",\"data\":{\"color\":{\"red\":255,\"green\":0,\"blue\":0},\"colorTemInKelvin\":0}}}",
    "response": "state",
    "source": "pact_tvlightv4/iot/v2/CmdColorWc.java"
   },
   {
    "cmd": "pt",
    "data": {
     "op": "mode|gradual|sleep|timer|wakeup",
