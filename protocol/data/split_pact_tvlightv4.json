    "response": "op",
    "source": "pact_tvlightv4/iot/CmdPt.java"
   },
   {
    "cmd": "ptReal",
    "data": {
     "command": [
      "<base64 20-byte frame>"
     ]
    },
    "example": "{\"msg\":{\"cmd\":\"ptReal\",\"data\":{\"command\":[\"WjMB...\"]}}}",
    "response": "op",
    "source": "pact_tvlightv4/iot/v2/CmdPtReal.java"
   },
   {
