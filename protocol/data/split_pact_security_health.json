    {"sku": "H7212", "family": "baby monitor / doorbell camera", "transports": ["iot"], "pact": {"type": null, "code": null}, "notes": "needBle=false; IoT V1 topic commands (turn, brightness, lullaby, listen/speak, socket); temp/hum sensor status."},
    {"sku": "H7214", "family": "baby monitor / doorbell camera", "transports": ["iot"], "pact": {"type": null, "code": null}, "notes": "needBle=false; same command set as H7212."},
    {"sku": "H5010", "family": "body-fat scale", "transports": ["ble"], "pact": {"type": null, "code": null}, "notes": "Qingniu (QN) BLE SDK; weight/body composition via QNScaleData; no Govee 20-byte frames."},
    {"sku": "H5020", "family": "smart jump rope", "transports": ["ble"], "pact": {"type": null, "code": null}, "notes": "Native Govee BLE scan/connect; name H5020_<mac>; sessions uploaded to REST (not IoT cmd)."}
  ],
  "ble": {
    "service_uuid": "494E5445-4C4C-495F-524F-434B535F4857",
    "characteristic_uuid": "494E5445-4C4C-495F-524F-434B535F2011",
    "frame": "H5026 pairing only: 20-byte Govee frame. H5010 uses QN SDK (unknown UUIDs). H5020 uses native com.govee.ble.BleController (unknown UUIDs).",
    "commands": [
      {"name": "H5026 pair notify", "op": "WifiNotifyParse", "payload": "none", "layout": "pairing only", "response": "wifi notify", "source": "h5026/add/{Ble,BleComm,BleNotifyComm}.java"},
      {"name": "H5020 scan", "op": "native", "payload": "ScanEventV1.SkipDevice", "layout": "{name,type,subType,communicationType,macAddr,services,rssi}; name H5020_<mac10..12><mac[-2:]>", "response": "scan event", "source": "skipv1/sku/H5020BleProcessor.java; SkipBleDeviceModel.java"},
      {"name": "H5020 session", "op": "native", "payload": "unknown", "layout": "app model Skip/SkipData: skipNum, spendTime, skipType, tripRope, averageFrequency, fastestFrequency, maxJumps, ripRopes[], calories, time", "response": "history records", "source": "skipv1/db/Skip.java; adjust/history/SkipData.java"},
      {"name": "H5010 weight", "op": "QN SDK", "payload": "unknown", "layout": "QNScaleData / QNScaleStoreData", "response": "weight + body composition", "source": "scalev1/manager/ScaleApi.java"}
    ],
    "notifications": [
      {"name": "H5026 wifi notify", "op": "pairing", "layout": "WifiNotifyParse", "source": "h5026/add/BleNotifyComm.java"},
      {"name": "H5010 scale data", "op": "QN callback", "layout": "QNScaleDataListener", "source": "scalev1/manager/ScaleApi.java"},
      {"name": "H5020 jump data", "op": "native callback", "layout": "SkipData fields", "source": "skipv1/adjust/DetailAc.java"}
    ]
  },
