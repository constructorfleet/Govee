  "other_protocols": [
    {"name": "cloud-gx-fallback", "details": "GX messages are Route.PreferBle(true); if BLE is unavailable they tunnel as ptReal, or ptIot when OTA pact support says so.", "source": "h5770/vm/H5770Repository.java; H5770SharedViewModel.java"},
    {"name": "work-mode-cloud-sync", "details": "POST JSON {device,sku,workMode} to a generic settings endpoint to keep cloud/Alexa scene state consistent; workMode = THERMO 2, DIY 3, MANUAL 1.", "source": "h5770/setting/modechange/H5770WorkModeCloudSync.java"},
    {"name": "email-alarms", "details": "REST: /bff-app/v2/account/notification-emails, /bi/rest/v1/notification-emails, bff-app/v1/device/email-alert/bind-rel, /bff-app/v1/device/email-alert/list-rel.", "source": "h5770/net/IH5770Net.java"},
    {"name": "chart-upload", "details": "Chart read over BLE char ...2015, upload via /bff-app/v1/device/series-datas; download tasks /device/data-tasks and links /device/data-links.", "source": "h5770/chart/H5770ChartViewModel.java"},
    {"name": "ota", "details": "Pact report frame {0xAB,2,pactTypeLo,pactTypeHi,pactCode} via ptReal or ptIot.", "source": "H5770SharedViewModel.writeOtaInfo"}
