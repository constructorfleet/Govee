  "dynamic_effects": [
    {"name": "manual mode", "submode": "0x01", "payload": "01", "attributes": ["relay/manual", "gear STOP"], "source": "H5770ModeCmd.java"},
    {"name": "thermo mode", "submode": "0x02", "payload": "02 gear tempBE16", "attributes": ["gear STOP/AUTO/HEAT/COOL", "target temp BE16 *10 (F)"], "source": "H5770ModeCmd.java"},
    {"name": "DIY humidity mode", "submode": "0x03", "payload": "03 humidityBE16", "attributes": ["humidity BE16 *10 %"], "source": "H5770ModeCmd.java"},
    {"name": "schedule item", "submode": "0x14", "payload": "nameLen,name,index,enabled,startH,startM,endH,endM,repeat,mode4", "attributes": ["repeat bit7 enabled, bits0-6 Mon-Sun", "max 5 schedules", "mode 1 manual / 2 thermo / 3 humidity"], "source": "H5770ScheduleItemCodec.java"}
  ],
  "notes": "H5770Support is referenced by H6630 but not present in this split; feature gates are inline. Chart request opcodes are inherited from base_h71xx chart_v2 (split only fixes UUIDs and record parsing). Endianness is mixed: 16/24-bit big-endian, some 32-bit fields big-endian and some little-endian. Thermo mode/schedule/alarm temperatures are Fahrenheit on the wire and Celsius in DeviceState/Heartbeat. No Matter/MQTT code in split."
}
