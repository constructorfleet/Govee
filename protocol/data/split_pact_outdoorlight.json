    "frame": "20 bytes: [0]=proType 0x33 write / 0xAA read / 0xA3-0xA5 multi; [1]=cmdType; [2..18]=payload; [19]=XOR BCC",
    "commands": [
      {"name": "power", "op": "0x33/0x01", "payload": "00|01", "layout": "[0] on/off", "response": "0xAA/0x01 -> [0]", "source": "base2light SwitchController used by all four pact Comm classes"},
      {"name": "brightness", "op": "0x33/0x04", "payload": "<level>", "layout": "[0] level (H7040 1..254; H7056/H7080 raw; H7086 remap only if Support.c()[2]==1)", "response": "0xAA/0x04 -> [0]", "source": "h7040/pact/Comm.java; h7056/pact/Comm.java; h7080/pact/Comm.java; h7086/pact/Comm.java"},
      {"name": "mode", "op": "0x33/0x05", "payload": "<submode>", "layout": "[0] sub-mode id", "response": "0xAA/0x05 -> [0] submode", "source": "base AbsModeController + family ModeController"},
