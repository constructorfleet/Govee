   },
   {
    "cmd": "status",
    "data": {},
    "example": "{\"cmd\":\"status\"}",
    "response": "{onOff,result} + op frames",
    "source": "h7141/iot/CmdStatus.java; CmdStatusParseV1$State"
   },
   {
    "cmd": "ptReal",
