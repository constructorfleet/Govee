 "ble": {
  "service_uuid": "00010203-0405-0607-0809-0a0b0c0d1910",
  "characteristic_uuid": "00010203-0405-0607-0809-0a0b0c0d2b11",
  "frame": "20 bytes: [0]=proType [1]=cmdType [2..18]=payload [19]=XOR BCC; multi write proType 0xA3 with index in [2]",
  "commands": [
   {
    "name": "power",
    "op": "0x33/0x01",
    "payload": "01|00",
    "layout": "[0] on/off",
    "response": "0xAA/0x01 -> [0] state",
    "source": "base2light SwitchController"
   },
   {
    "name": "mode",
    "op": "0x3A/0x05 (H7140-class) or 0x33/0x05 (H7141/H7142)",
    "payload": "GEAR: 01 g; CUSTOM: 02 idx 3x5 bytes; AUTO: 03 hum[|0x80] comfortable",
    "layout": "see dynamic_effects/mode sections",
    "response": "0xAA/0x05 -> [mode, params]",
    "source": "h7140/ble/controller/H7140ModeController.java; h7141/ble/controller/Mode*Controller.java"
   },
   {
    "name": "gear position",
    "op": "0x33/0x1C",
    "payload": "02 gear (high) | 01 gear (low)",
    "layout": "[0] high/low selector, [1] gear index",
    "response": "0xAA/0x1C -> [02,highGear] or [01,lowGear]",
    "source": "h7140/ble/controller/GearPositionController.java"
   },
   {
    "name": "clean reminder",
    "op": "0x33/0x27 (H7140 class) or 0x33/0x08 (H7141)",
    "payload": "open,setCleanHour",
    "layout": "[0] open (1/2), [1] set hours",
    "response": "[open,setHour,remainHour]",
    "source": "base_h71xx CleanReminderController; h7141/Clear72HController.java"
   },
   {
    "name": "delay off",
    "op": "0x33/0x11",
    "payload": "open minLo minHi",
    "layout": "[0] open, [1..2] minutes LE16",
    "response": "[open,minLo,minHi,leaveLo,leaveMid,leaveHi]",
    "source": "base_h71xx DelayOffController; DelayOffInfo"
   },
   {
    "name": "do not disturb",
    "op": "0x33/0x16",
    "payload": "enable startH startM endH endM",
    "layout": "forever = 01 01 01 01 01",
    "response": "same",
    "source": "base_h71xx NotDisturbController; NotDisturbInfo"
   },
   {
    "name": "time sync",
    "op": "0x33/0x1B",
    "payload": "ts[4] 01 tzHour tzMin",
    "layout": "4-byte little-endian epoch seconds",
    "response": "ack",
    "source": "base_h71xx SyncTimeController"
   },
   {
    "name": "device status (H7151/H7152/H7153)",
    "op": "0xAA/0x19",
    "payload": "",
    "layout": "read only",
    "response": "[0..1] autoStopSec LE, [2] dry, [3..4] dryCountdownSec LE, [5] compressor, [6] fan, [7] pipe, [8] draining",
    "source": "h7151/ble/controller/DeviceStatusController.java; h7151/DeviceState.java"
   },
   {
    "name": "child lock (H7150/H7151/H7152/H7153)",
    "op": "0x33/0x1F",
    "payload": "02 00|01",
    "layout": "[0] subcmd 0x02, [1] state",
    "response": "[02,state]",
    "source": "h7150/ble/controller/LockControllerV1.java"
   },
   {
    "name": "power-on state (H7151)",
    "op": "0x33/0x1F",
    "payload": "09 00|01",
    "layout": "[0] subcmd 0x09",
    "response": "[09,state]",
    "source": "h7151/ble/controller/PowerOnController.java"
   },
   {
    "name": "off-dry switch (H7151)",
    "op": "0x33/0x1F",
    "payload": "0A 00|01",
    "layout": "[0] subcmd 0x0A",
    "response": "[0A,state]",
    "source": "h7151/ble/controller/OffDrySwitchController.java"
   },
   {
    "name": "off water-pump switch (H7151)",
    "op": "0x33/0x1F",
    "payload": "0B 00|01",
    "layout": "[0] subcmd 0x0B",
    "response": "[0B,state]",
    "source": "h7151/ble/controller/OffWaterPumpSwitchController.java"
   },
   {
    "name": "start drainage (H7151)",
    "op": "0x33/0xAA",
    "payload": "00 00 01",
    "layout": "drainage trigger",
    "response": "ack",
    "source": "h7151/ble/controller/OffDrainageController.java"
   },
   {
    "name": "start dry (H7151)",
    "op": "0x33/0xAA",
    "payload": "00 01",
    "layout": "dry trigger",
    "response": "ack",
    "source": "h7151/ble/controller/OffDryController.java"
   },
   {
    "name": "read switch (H7145)",
    "op": "0xAA/0x1A",
    "payload": "",
    "layout": "read only",
    "response": "[0] on/off",
    "source": "h7145/ble/controller/ReadSwitchController.java"
   },
   {
    "name": "water tank level (H7145)",
    "op": "0xAA/0x22",
    "payload": "",
    "layout": "read only",
    "response": "[0] percent, [1..2] endurance minutes LE16",
    "source": "h7145/ble/controller/WaterVieldController.java; h7145/adjust/bean/WaterBean.java"
   },
   {
    "name": "temperature/humidity calibration (H7145)",
    "op": "0x33/0x1C",
    "payload": "V1 01 deviceFlag tempFlag calLE16; V2 deviceFlag tempFlag calLE16; V3 tempFlag deviceFlag calLE16",
    "layout": "signed int16, 0.01C / 0.01%RH",
    "response": "deviceFlag + tempFlag + calLE16",
    "source": "h7145/ble/DevCommReportParse.java; base_h71xx TempHumCaliCtler"
   },
   {
    "name": "timer add/update",
    "op": "0x33/0x01",
    "payload": "group enableSwitch hour min repeat mode modeValue [targetHum autoGear]",
    "layout": "see TimerInfoV2",
    "response": "0xAA/0x01 -> timer record",
    "source": "base_h71xx TimerGroupControllerV2; h7151/H7152TimerGroupController.java"
   },
   {
    "name": "timer delete",
    "op": "0x33/0x1E",
    "payload": "",
    "layout": "read/delete",
    "response": "[group]",
    "source": "base_h71xx TimerCountController"
   },
   {
    "name": "abnormal info",
    "op": "0x33/0xAA",
    "payload": "01",
    "layout": "[0] request",
    "response": "[fault,code,flag2,...,flag3]",
    "source": "h7140/h7143/h7145/h7150/h7151/h7160/h7161 AbnormalInfoController"
   },
   {
    "name": "atmosphere list (H7161/H7162)",
    "op": "0xAA/0x05",
    "payload": "03",
    "layout": "read preset list",
    "response": "one-byte atmosphere codes after first byte",
    "source": "h7161/ble/controller/AtmosphereListController.java"
   },
   {
    "name": "atmosphere edit (H7161/H7162)",
    "op": "0xA3/0x05",
    "payload": "count, per-edit index,length,onOffFog,onOffVoice,voiceCode,voiceVolume,atmosphereCode,onOffLight,brightness,subMode,[color/scene/diy]",
    "layout": "see AtmosphereEdit.getWriteBytes",
    "response": "ack",
    "source": "h7161/ble/controller/AtmosphereEditMultipleControl.java; base_h71xx AtmosphereEdit"
   },
   {
    "name": "uncovering remind (H7161)",
    "op": "0x33/0x1F",
    "payload": "01 00|01",
    "layout": "[0]=1, [1]=state",
    "response": "ack",
    "source": "h7161/ble/controller/UncoveringRemindController.java"
   }
  ],
  "notifications": [
   {
    "name": "device report",
    "op": "0xEE/<cmdType>",
    "layout": "[1]=cmdType, [2..] payload; 0x05=mode, 0xAA=abnormal, 0xB0=light, 0x1C=gear, 0x22=water, 0x19=status",
    "source": "h71*/ble/DevCommReportParse.java; h71*/ble/BleNotifyComm.java"
   },
   {
    "name": "IoT/WiFi status",
    "op": "0xEE",
    "layout": "handled by WifiNotifyParse",
    "source": "h71*/ble/WifiNotifyParse.java"
   }
  ]
 },
 "iot": {
