      {"name": "scene multi-packet", "op": "0xA3/0x01..0x0A", "payload": "base64 scene effect blob", "layout": "cmdType = scene protocol version (V1=0x01, V2=0x02, V5=0x0A...); blob from ScenesRgbIC/ScenesGraffiti/ScenesCube/ScenesCompose keyed by effect id; followed by 0x05/0x04 select", "response": "write ack", "source": "decompiled/jadx-base-7.7.10/sources/com/govee/base2light/ble/ScenesOp.java"},
      {"name": "sleep", "op": "0x33/0x11", "payload": "11 [4 bytes]", "layout": "sleep hour/min/brightness/color index", "response": "0xAA/0x11 -> [0..3]", "source": "decompiled/jadx-base-7.7.10/sources/com/govee/base2light/ble/controller/SleepController.java"},
