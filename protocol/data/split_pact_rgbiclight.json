  "iot": {
    "envelope": "Write/AbsCmdWrite: {msg:{transaction,accountTopic,type:1,origin:32,cmdVersion,cmd,data}}; read type:0. Incoming h6160/rgbiclight uses IotMsgProType.V2; dreamcolorlightv1 V0/V1 parses 'state' and 'op'.",
    "commands": [
      {"cmd": "online", "data": {}, "response": "device online event", "source": "rgbiclight/h6160/iot/Cmd.java, dreamcolorlightv1/iot/Cmd.java"},
      {"cmd": "turn", "data": {"val": "0|1"}, "response": "status.turn", "source": "rgbiclight/h6160/iot/CmdTurn.java, base2light/iot/CmdTurn.java"},
      {"cmd": "brightness", "data": {"val": "0-100"}, "response": "status.brightness", "source": "rgbiclight/h6160/iot/CmdBrightness.java"},
      {"cmd": "color", "data": {"red": "0-255", "green": "0-255", "blue": "0-255"}, "response": "status.color", "source": "rgbiclight/h6160/iot/CmdColor.java"},
      {"cmd": "colorTem", "data": {"colorTemInKelvin": "int", "color": {"red": "int", "green": "int", "blue": "int"}}, "response": "status.colorTemInKelvin", "source": "rgbiclight/h6160/iot/CmdColorTem.java"},
      {"cmd": "colorwc", "data": {"color": {"red": "int", "green": "int", "blue": "int"}, "colorTemInKelvin": "int"}, "response": "status", "source": "rgbiclight/h6160/iot/CmdColorWc.java, base2light/iot/CmdColorWc.java"},
      {"cmd": "status", "data": {"softversion": "str", "wifiSoftVersion": "str", "turn": "0|1", "brightness": "int", "mode": "int", "color": {"red": "int", "green": "int", "blue": "int"}, "colorTemInKelvin": "int", "timer": {"enable": "0|1", "time": [{"openHour": "int", "openMin": "int", "closeHour": "int", "closeMin": "int"}]}}, "response": "CmdStatusV0", "source": "rgbiclight/h6160/iot/CmdStatusV0.java"},
      {"cmd": "timer", "data": {"enable": "0|1", "timeOffset": "int", "timeOffsetMinute": "int", "time": [{"enable": "0|1", "openHour": "int", "openMin": "int", "closeHour": "int", "closeMin": "int", "repeat": "byte"}], "isGroup": "0|1", "group": "int"}, "response": "timer info", "source": "rgbiclight/h6160/iot/CmdTimer.java"},
      {"cmd": "pt", "data": {"op": "mode|gradual|sleep|wakeup|timer", "value": ["base64 20-byte frame"]}, "response": "op payload parsed by CmdStatusV0/V1", "source": "rgbiclight/h6160/iot/CmdPt.java, dreamcolorlightv1/iot/CmdPt.java"},
      {"cmd": "ptReal", "data": {"command": ["base64 20-byte frame"]}, "response": "status/pt reply; opVersion for music", "source": "rgbiclight/h6160/iot/CmdPtReal.java, dreamcolorlightv1/iot/CmdPtReal.java"},
      {"cmd": "bulb", "data": {"value": ["base64 frame"]}, "response": "per-bulb color + gradual", "source": "dreamcolorlightv1/iot/CmdBulb.java"},
      {"cmd": "gradual", "data": {"val": "0|1"}, "response": "gradual state", "source": "dreamcolorlightv1/iot/Cmd.java"},
      {"cmd": "state (read key)", "data": {"brightness": "int", "mode": "int", "onOff": "0|1", "wifiHardVersion": "str", "wifiSoftVersion": "str"}, "response": "CmdStatusV0/V1", "source": "dreamcolorlightv1/iot/CmdStatusV0.java, CmdStatusV1.java"},
      {"cmd": "op (read key)", "data": {"pt|ptReal payloads": "base64"}, "response": "Passthrough results (timer/sleep/wakeup/mode/color)", "source": "dreamcolorlightv1/iot/Cmd.java#getCmdReadParseKey"}
    ],
    "status": {
      "fields": {
        "on": "bool (turn==1)",
        "brightness": "int 0-100 (BLE maps to 6-254/20-254)",
        "mode": "int: 2 = color/color-temp",
        "color": "red,green,blue 0-255",
        "colorTemInKelvin": "int (valid set from Constant.getColorTemKelvinSet)",
        "softversion": "string",
        "wifiSoftVersion": "string",
        "timer": "enable + up to 4 time slots (openHour/openMin/closeHour/closeMin/repeat)",
        "segmentColors": "per-segment RGB arrays via op/ptReal (CmdStatusV1.parseIc)"
      },
      "source": "decompiled/jadx-splits/split_pact_rgbiclight/sources/com/govee/rgbiclight/h6160/iot/CmdStatusV0.java; dreamcolorlightv1/iot/CmdStatusV0.java, CmdStatusV1.java"
    }
  },
  "other_protocols": [
    {"name": "matter", "details": "MatterInterceptor registered for goodsType 193 (H70A1/H70A2/H70A3, soft>=1.00.11/wifi 3.05.00; H70A3 soft>=1.00.18), 204 (soft>=1.00.08 && wifi>=3.04.01 or wifi>=3.08.01), 71 (H619D, soft>=3.04.39/wifi 3.01.10), 19 (H61A8, soft>=3.08.01). Standard lighting clusters; no custom cluster IDs in this split.", "source": "decompiled/jadx-splits/split_pact_rgbiclight/sources/com/govee/rgbiclight/MatterRegister.java"},
