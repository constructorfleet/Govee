      {"name": "old DIY", "op": "0x33/0x05 sub 0x07", "payload": "07 [16-byte DIY protocol]", "layout": "[0]=diyCode [1..3]=params [4..]=RGB triples (max 4 colors); H6127/H6129", "response": "0xAA/0x05 -> [1]=diy code", "source": "decompiled/jadx-splits/split_pact_rgbiclight/sources/com/govee/h6129/ble/SubModeOldDiy.java"},
      {"name": "limit/current", "op": "0x33/0x0E", "payload": "0E", "layout": "[0]=limit flag (0/1); H6102/H6105 only", "response": "0xAA/0x0E -> [0]==1", "source": "decompiled/jadx-splits/split_pact_rgbiclight/sources/com/govee/h6102/ble/LimitController.java"},
      {"name": "gradual (single-packet)", "op": "0x33/0x14", "payload": "14 00|01", "layout": "[0] gradient on/off; H6119/H6125/H6126", "response": "0xAA/0x14 -> [0]", "source": "decompiled/jadx-splits/split_pact_rgbiclight/sources/com/govee/h6119/ble/Gradual4BleController.java"},
      {"name": "gradual (wifi-ble)", "op": "0x33/0xA3", "payload": "A3 00|01", "layout": "[0] gradient on/off; H6163/H6117, H7090/H7095, barelight, chassis", "response": "0xAA/0xA3 -> [0]", "source": "decompiled/jadx-splits/split_pact_rgbiclight/sources/com/govee/h6160/ble/v1/Gradual4BleWifiController.java"},
      {"name": "light position", "op": "0x33/0x31", "payload": "31 00|01", "layout": "[0] position 0/1; H7090/H7095", "response": "0xAA/0x31 -> [0]", "source": "decompiled/jadx-splits/split_pact_rgbiclight/sources/com/govee/h7090/ble/LightPosController.java"},
      {"name": "left/right switch", "op": "0x33/0x33", "payload": "33 <state>", "layout": "state 0=off, 1=left, 16=right, 17=both; H7090/H7095 car light", "response": "0xAA/0x33 -> [0] state, [1]==1 festive flag", "source": "decompiled/jadx-splits/split_pact_rgbiclight/sources/com/govee/h7090/ble/SwitchLRController.java"},
      {"name": "multi DIY upload", "op": "0xA5/0x02", "payload": "diyCode params rgbLen [RGB triples] brightLen [brightness]", "layout": "multi-packet; [0]=diyCode [1]=style [2] [3] [4]=rgbLen [5..]=RGB [..]=brightnessLen [..]=brightness", "response": "write ack", "source": "decompiled/jadx-base-7.7.10/sources/com/govee/base2light/ble/controller/MultipleDiyController.java"},
      {"name": "DIY V1 upload", "op": "0xA5/0x04", "payload": "DIY protocol bytes", "layout": "multi-packet variant used by newer DIY templates", "response": "write ack", "source": "decompiled/jadx-base-7.7.10/sources/com/govee/base2light/ble/controller/MultipleDiyControllerV1.java"},
      {"name": "graffiti DIY upload", "op": "0xA5/0x03", "payload": "graffiti blob", "layout": "multi-packet; V3 variant uses cmd 0x57", "response": "write ack", "source": "decompiled/jadx-base-7.7.10/sources/com/govee/base2light/ble/controller/MultiDiyGraffitiController.java"},
      {"name": "multi music upload", "op": "0xA3/0x41", "payload": "music effect blob", "layout": "multi-packet; [4]=sensitivity (controller.p()), blob from AbsNewMusicEffect", "response": "write ack", "source": "decompiled/jadx-base-7.7.10/sources/com/govee/base2light/ble/controller/MultipleController4Music.java"},
