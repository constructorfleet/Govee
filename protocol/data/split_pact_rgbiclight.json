      {"name": "check direction", "op": "0x33/0x39", "payload": "39", "layout": "direction setup finish query", "response": "0xAA/0x39 -> [0]", "source": "decompiled/jadx-base-7.7.10/sources/com/govee/base2light/ble/controller/CheckDirectionFinishController.java"},
